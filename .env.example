# =============================================================================
# CLINIGO - CONFIGURACAO DE VARIAVEIS DE AMBIENTE (.env.example)
# =============================================================================

# Supabase (Banco de Dados, Autenticacao e Storage Legado/Fallback)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URLs e Aplicacao
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# CLOUDFLARE R2 (Storage Desacoplado - Zero Custo de Egress)
# =============================================================================
# Obter na aba "R2" do painel Cloudflare:
# 1. R2_ACCOUNT_ID: Encontrado na barra lateral direita da pagina R2 ("Account ID")
# 2. R2_ACCESS_KEY_ID: Gerado em "Manage R2 API Tokens" -> "Create API Token" (Permissao: Object Read & Write)
# 3. R2_SECRET_ACCESS_KEY: Gerado junto com o Access Key ID
# 4. R2_BUCKET_NAME: Nome do bucket criado no R2 (ex: clinigo-patient-documents)
# 5. R2_ENDPOINT: Opcional, calculado automaticamente se omitido: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=clinigo-patient-documents
R2_ENDPOINT=

# =============================================================================
# FEATURE FLAGS DE STORAGE (Rollback instantaneo sem necessidade de deploy)
# =============================================================================
# Valores aceitos: 'supabase' ou 'r2'
# Se configurado como 'r2' e as credenciais acima estiverem preenchidas,
# novos uploads serao gravados diretamente no Cloudflare R2.
# Se vazio, 'supabase', ou se o R2 falhar, o sistema usa Supabase Storage como fallback.
STORAGE_PROVIDER_DEFAULT=supabase
STORAGE_PROVIDER_PATIENT_DOCUMENTS=supabase
